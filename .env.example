# 复制本文件为 .env，填入你自己的值。
# .env 已被 .gitignore 忽略，不会提交；本模板不含任何真实密钥。

# ---- 必填 ----
# 知乎开放平台 → 个人中心 → Access Secret 管理
ZHIHU_ACCESS_SECRET=
# 大模型 Key（默认用 DeepSeek；也可换成下面的第三方）
DEEPSEEK_API_KEY=

# ---- 可选：换用其他 OpenAI 兼容大模型 ----
# 智谱 GLM-4-Flash（永久免费）
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# 阿里百炼
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-turbo
# 硅基流动
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_JSON_MODE=1
